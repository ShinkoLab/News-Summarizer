# docker-compose.yml（フルスタック: Miniflux + Summarizer + Viewer）専用の設定テンプレート。
# ローカルでの `uv run python main.py` 実行には `config.yaml.example` を使う。
#
# 最短の使い方（詳しくは README の「クイックスタート」）:
#   1. cp .env.example .env
#   2. 下の「LLM」を1つ選んで、LLM_MODEL などを埋める
#   3. docker compose up -d
#   4. http://localhost:3080 を開く（最初の要約が出るまで数分〜）
# 必須なのは LLM の設定だけ。それ以外は既定のままで動く。

# ---------------------------------------------------------------------------
# Miniflux: 同梱 or 手元の既存
# ---------------------------------------------------------------------------
# 同梱の Miniflux を一緒に起動する（既定）。管理画面は http://localhost:8080 で、
# フィードはそこで追加する（初回は定番フィード5件を自動で登録する）。
COMPOSE_FILE=docker-compose.yml:compose.miniflux.yml
#
# すでに Miniflux を持っているならそれに接続する。上の行を次の設定に差し替える
# （同梱の Miniflux / PostgreSQL は起動しない。スターターフィードも登録しない）:
#   COMPOSE_FILE=docker-compose.yml
#   MINIFLUX_BASE_URL=http://host.docker.internal:8080   # コンテナから届く URL
#   MINIFLUX_API_KEY=...   # Miniflux の 設定 > API キー で作る。外部では必須
# （Windows では COMPOSE_FILE の区切りが `;` になる。）

# Published ports bind to loopback only. Set BIND_ADDRESS=0.0.0.0 to expose them
# on the LAN, but change the passwords below first (the Viewer has no auth).
#BIND_ADDRESS=127.0.0.1

# --- 同梱 Miniflux 用（既存の Miniflux に接続するときは使われない） ---
MINIFLUX_PORT=8080
MINIFLUX_ADMIN_USERNAME=admin
# These are exposed on localhost with no other auth layer in front of them.
# Change both passwords before exposing this stack beyond your own machine
# (e.g. `openssl rand -hex 16`).
MINIFLUX_ADMIN_PASSWORD=change-me
# MINIFLUX_POSTGRES_PASSWORD goes into a postgres:// URL: use URL-safe characters
# only (letters, digits, - _ . ~), e.g. `openssl rand -hex 16`.
MINIFLUX_POSTGRES_PASSWORD=change-me
# 同梱では空のままでよい（管理者アカウントから summarizer が自動で発行する）。
# 既存の Miniflux では必須（上記）。
MINIFLUX_API_KEY=
# 初回だけ docker/feeds.opml のスターターフィードを登録するか。空 = 同梱なら true、
# 既存の Miniflux なら false。フィードが 0 件のときだけ登録し、一度やったら繰り返さない。
#MINIFLUX_IMPORT_STARTER_FEEDS=

# ---------------------------------------------------------------------------
# LLM（OpenAI 互換エンドポイントを1つ選ぶ）
# 1 回の実行で記事ごとに LLM を呼ぶ（要約 + グルーピング + ダイジェスト）。有料の API
# では実行ごとに費用がかかるので、まず下の件数の既定（20 件 / 3 時間おき）で試すこと。
# ---------------------------------------------------------------------------
LLM_PROVIDER=openai

# (a) ホスト上の Ollama（無料。`ollama pull <model>` 済みで `ollama serve` が動いていること）
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=
# 例: LLM_MODEL=qwen3:8b

# (b) OpenRouter（有料。https://openrouter.ai/keys で API キーを作る）
#LLM_BASE_URL=https://openrouter.ai/api/v1
#LLM_API_KEY=sk-or-...
#LLM_MODEL=google/gemini-2.5-flash

# (c) その他の OpenAI 互換エンドポイント（OpenAI / llama-swap / vLLM / LM Studio など）
#LLM_BASE_URL=https://api.openai.com/v1
#LLM_API_KEY=sk-...
#LLM_MODEL=gpt-4o-mini

# サーバーが response_format（構造化出力）を受け付けないときは false にする。
# 要約が JSON パースエラーで失敗し続ける、HTTP 400/500 が返る、といった症状のとき:
#   - llama-swap / MLX の推測デコード付きモデルは HTTP 500
#     "Structured response_format is not supported with speculative decoding" を返す
#   - gemma-4-26b-a4b のように response_format を無視してただの文章を返すモデルもある
# false なら JSON の例を示したプレーンテキストのプロンプトに切り替え、返答から JSON を取り出す。
LLM_STRUCTURED_OUTPUT=true
LLM_MAX_RETRIES=3
# Thinking/reasoning models spend a few hundred to 1000+ tokens on
# reasoning_content before the actual answer; too low a value here silently
# truncates the JSON output to nothing. 8192 is a safe default for per-article
# summarization, but the grouper's topic-naming call (all clusters in one
# response) and the digest step can need more — confirmed on a local thinking
# model that 8192 truncated topic-naming's JSON on every retry (parse errors:
# "EOF while parsing a value"), while 16384 passed first try with the same
# article set. Raise this if grouping or digest keeps failing with JSON parse
# errors, especially with many articles/categories in one run.
LLM_MAX_TOKENS=16384

# Embedding-based grouping (summarizer.steps.grouper.use_embeddings). Requires
# LLM_EMBEDDING_MODEL; EMBEDDING_BASE_URL/EMBEDDING_API_KEY are only needed if
# the embedding model lives on a different endpoint than LLM_BASE_URL.
GROUPER_USE_EMBEDDINGS=false
LLM_EMBEDDING_MODEL=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# ---------------------------------------------------------------------------
# News Summarizer（お試し向けに控えめな既定。慣れたら増やす）
# ---------------------------------------------------------------------------
# 取得元。all = RSS(Miniflux) + メール(POP3)。メール未設定（EMAIL_HOST が空）なら
# メールは自動的に無視される。rss / email に絞ることもできる。
NEWS_SUMMARIZER_SOURCE=all
# 実行間隔（秒）。10800 = 3 時間
NEWS_SUMMARIZER_INTERVAL_SECONDS=10800
LOG_LEVEL=INFO
# Per-run intake. These two are a pair and the smaller one wins: Miniflux caps
# /v1/entries at 100 unless a limit is passed, so raising only
# MAX_ARTICLES_PER_RUN changes nothing. Keep MINIFLUX_FETCH_LIMIT ~25% above it
# (dedup drops ~10% of every fetch). 本番相当にするなら 100 / 125 など
# （空にすると組み込みの既定 100 / 100）。残りは次回の実行に繰り越される。
MAX_ARTICLES_PER_RUN=20
MINIFLUX_FETCH_LIMIT=25
# Convert Miniflux's HTML bodies to plain text before the LLM sees them
# (~80% fewer input tokens). Set false to pass raw HTML through.
MINIFLUX_STRIP_HTML=true
TZ=Asia/Tokyo

# Email (POP3) source, used when NEWS_SUMMARIZER_SOURCE is email/all or
# `--source email` is passed. Leave EMAIL_HOST empty to disable.
EMAIL_HOST=
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_PORT=
EMAIL_USE_SSL=true
EMAIL_MAX_FETCH_ATTEMPTS=
EMAIL_DELETE_AFTER_PROCESSING=false

# Discord is optional. If empty, posting is skipped.
DISCORD_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# News Viewer
# ---------------------------------------------------------------------------
NEWS_VIEWER_PORT=3080
# Viewer は既定で GitHub のリリースタグから直接ビルドする（clone 不要）。手元の
# News-Viewer を開発しているときだけ、そのディレクトリを指す。
#NEWS_VIEWER_CONTEXT=../News-Viewer
# Default category order in the Viewer (comma-separated). Source of truth is the
# order in categories.yaml; leave unset to use the compose default, which mirrors it.
#CATEGORY_ORDER=
