project_id       = "your-google-cloud-project"
summarizer_image = "asia-northeast1-docker.pkg.dev/your-google-cloud-project/news-summarizer/summarizer:COMMIT_SHA"
viewer_image     = "asia-northeast1-docker.pkg.dev/your-google-cloud-project/news-summarizer/viewer:COMMIT_SHA"

viewer_users = [
  "you@example.com",
  "family@example.com",
]

llm_base_url = "https://your-openai-compatible-endpoint.example.com/v1"
llm_model    = "your-model-id"

# LLMパラメータ（省略時のデフォルト: グローバル temperature=0.7, max_tokens=8192、
# grouper/summarizer は temperature低め+reasoning_effort=low、digest は reasoning_effort=medium）
# reasoning_effort は reasoning model（GPT-5系等）のみ有効。非対応モデルでは無視されるか
# エラーになる場合があるため、モデルに応じて空文字や未設定に調整すること。
# llm_temperature             = 0.7
# llm_max_tokens              = 8192
# grouper_temperature         = 0.2
# grouper_reasoning_effort    = "low"
# summarizer_temperature      = 0.3
# summarizer_reasoning_effort = "low"
# digest_reasoning_effort     = "medium"

# 実行時刻（既定は "0 7 * * *" = 毎日7:00 JST の1日1回）。
# 発火回数を増やすときは Scheduler ジョブを足さず、この cron に時刻を並べる。
# schedule = "0 7,19 * * *"   # 1日2回: 7:00 と 19:00 JST
# schedule_time_zone = "Asia/Tokyo"

miniflux_base_url = "https://miniflux.example.com"
# 1回の実行で処理する記事数の上限（既定 100、config.py の制約で最大 200）と、
# Miniflux に要求する取得件数（既定 100、Miniflux の MaxEntryLimit で最大 1000）。
# **この2つはセットで見ること。** Miniflux は limit 未指定だとサーバ既定の 100 で
# 打ち切るため、max_articles_per_run だけ上げても実際の処理件数は増えない。
# 取得後の重複除去で1割前後落ちるので、fetch_limit は多めに取る。
# max_articles_per_run = 200
# miniflux_fetch_limit = 250
# メールを使わない場合もダミー値を設定してください（フェッチ失敗はソース単位で握りつぶされます）
email_host        = "pop.example.com"
email_username    = "news@example.com"
# 処理が終わったメールをPOP3サーバから削除する（既定 false）。削除対象はDB保存に
# 成功したメールと、max_fetch_attempts に達して打ち切ったメールのみ。
# email_delete_after_processing = true

# billing_account_id = "000000-000000-000000"
# monthly_budget_jpy = 2000
