# このファイルは `docker-compose.yml`（フルスタック: Miniflux + Summarizer + Viewer）専用。
# ローカルでの `uv run python main.py` 実行には `config.yaml.example` を使う。
#
# 使い方:
#   1. News-Viewer をこのリポジトリと同じ階層に clone しておく
#      （web サービスは ../News-Viewer をビルドコンテキストにする）
#   2. cp .env.example .env
#   3. 値を編集
#   4. docker compose up --build

# Miniflux
MINIFLUX_PORT=8080
MINIFLUX_ADMIN_USERNAME=admin
# These are exposed on localhost with no other auth layer in front of them.
# Change both passwords before exposing this stack beyond your own machine
# (e.g. `openssl rand -hex 16`).
MINIFLUX_ADMIN_PASSWORD=change-me
MINIFLUX_POSTGRES_PASSWORD=change-me
# Leave empty to let the summarizer create an API key from the admin account.
MINIFLUX_API_KEY=

# News Summarizer
NEWS_SUMMARIZER_SOURCE=rss
NEWS_SUMMARIZER_INTERVAL_SECONDS=3600
LOG_LEVEL=INFO
TZ=Asia/Tokyo

# OpenAI-compatible LLM endpoint (Ollama, llama-swap, OpenRouter, etc). Leaving
# this unset falls back to Vertex AI (config.py's Cloud Run default) and fails
# without GCP credentials, so keep it set to "openai" for a local/self-hosted LLM.
LLM_PROVIDER=openai
# For Ollama/llama-swap/etc running on the host machine, Docker Desktop can
# usually reach this URL (Linux native Docker needs the extra_hosts entry
# already set in docker-compose.yml for host.docker.internal to resolve).
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=
LLM_API_KEY=ollama
LLM_STRUCTURED_OUTPUT=true
LLM_MAX_RETRIES=3
# Some local/small models don't honor response_format (json_schema/json_object)
# at all and silently return plain prose — confirmed on at least one llama-swap
# + MLX backend. If summarization keeps failing with JSON parse errors, set this
# to false: the app falls back to a plain-text prompt (with a concrete JSON
# example, not the raw schema) and parses the JSON out of the response manually.
#LLM_STRUCTURED_OUTPUT=false
# Thinking/reasoning models spend a few hundred to 1000+ tokens on
# reasoning_content before the actual answer; too low a value here silently
# truncates the JSON output to nothing. 8192 is a safe default for most local
# thinking models; raise it further if the digest step gets truncated.
LLM_MAX_TOKENS=8192

# Embedding-based grouping (summarizer.steps.grouper.use_embeddings). Requires
# LLM_EMBEDDING_MODEL; EMBEDDING_BASE_URL/EMBEDDING_API_KEY are only needed if
# the embedding model lives on a different endpoint than LLM_BASE_URL.
GROUPER_USE_EMBEDDINGS=false
LLM_EMBEDDING_MODEL=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# Discord is optional. If empty, posting is skipped.
DISCORD_WEBHOOK_URL=

# News Viewer
NEWS_VIEWER_PORT=3080
