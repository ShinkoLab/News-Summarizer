# LLM (OpenAI Compatible API) の設定
llm:
  # Cloud Run + Vertex AI では "vertex"。ローカルOllamaでは "openai"。
  # エンドポイントが /v1/chat/completions ではなく OpenAIの Responses API
  # （/v1/responses）しか提供しないモデルの場合は "openai_responses"
  # （例: OpenCode Zenのgpt-5.6-luna, grok-4.6。詳細はinfra/DEPLOYMENT.md参照）
  provider: "openai"
  base_url: "http://127.0.0.1:11434/v1"
  model: "your-model-name" # 使用するモデル名
  # Vertex AI利用時（Cloud Runでは環境変数から設定可能）
  #project_id: "your-google-cloud-project"
  #location: "global"
  # api_key: "your-api-key"  # APIキー（省略時は "ollama"。OpenAI等の場合は sk-... を指定）

  # OpenAI互換APIの標準パラメータ（全ステップ共通デフォルト、省略可能）
  # ステップ固有の summarizer.steps.<step>.parameters で上書きできます
  #parameters:
  #  temperature: 0.3
  #  top_p: 0.9
  #  max_tokens: 8192          # 最大出力トークン数（Ollama では num_predict に相当）。無限生成防止に有効
  #  reasoning_effort: "medium"  # o1/o3/o4-mini など reasoning 対応モデル向け ("low" | "medium" | "high")

  # モデル固有の特殊なパラメータ（APIプロバイダー固有の拡張フィールド、省略可能）
  # Ollama で thinking を有効にする場合の例:
  #extra_body:
  #  think: true           # Ollama thinking モードを有効化
  #  think_budget: 8192    # 思考トークン予算（省略可能）
  #  options:
  #    num_ctx: 4096

  # thinking フラグ: temperature の自動除外にのみ使用（disable_temperature_with_thinking と組み合わせる）
  # ※ thinking 自体の有効化は extra_body で行ってください
  #thinking: true

  # Gemma 4 のThinking安定化: true にするとシステムプロンプト先頭に <|think|> を自動注入する
  # extra_body: think: true と組み合わせて使用してください
  #gemma4_think: true

  # thinking 有効時に temperature を自動除外する（thinking モデルで temperature が非推奨の場合に有効化）
  #disable_temperature_with_thinking: true

  # LLM 生成失敗時の再試行回数（JSON パースエラー等が発生した場合に再試行する。デフォルト: 3）
  #max_retries: 3

  # Structured Output を使用するか（デフォルト: true）
  # false にすると response_format を使わず、プロンプトで JSON 出力を指示して手動パースする。
  # Structured Output 非対応プロバイダー（一部ローカル LLM 等）や Repetition 問題の回避に使用。
  #structured_output: true

  # Embedding モデル（省略時は LLM による直接グルーピングを使用）
  # Ollama で利用可能な embedding 専用モデルを指定してください。
  # 例: ollama pull bge-m3
  #embedding_model: "bge-m3"

  # チャット用LLM（base_url/api_key）が embedding に対応していない場合
  # （例: OpenCode Zen 等）、embedding だけ別プロバイダへ向けることができます。
  # 省略時は base_url / api_key をそのまま流用します。
  # 例: OpenRouter の Embeddings API（OpenAI互換）を使う場合
  #embedding_model: "openai/text-embedding-3-small"
  #embedding_base_url: "https://openrouter.ai/api/v1"
  #embedding_api_key: "your-openrouter-api-key"

# 要約設定
summarizer:
  # 暴走時のLLM費用を抑えるための1実行あたり上限
  max_articles_per_run: 100
  # 個別要約の最大文字数
  individual_max_length: 200
  # ダイジェストの最大文字数
  # カテゴリごとの割り当ては記事数に比例配分される（下限120字）
  digest_max_length: 3000
  # カテゴリ一覧・各カテゴリの定義文・判定のタイブレーク規則、および
  # 定義外カテゴリが返され続けた場合のフォールバックは、リポジトリ直下の
  # categories.yaml で一元管理する（ローカル実行・Cloud Run 実行で共通）。
  # 読み込むファイルは CATEGORIES_PATH 環境変数で差し替え可能。

  # カテゴリ検証失敗時の再試行回数（省略時: 3）
  # llm.max_retries（APIエラー・JSONパース失敗用）とは独立した設定
  #category_max_retries: 3

  # ステップ別 LLM パラメータ設定
  # 省略したパラメータは llm.parameters のグローバル設定を継承します
  steps:
    grouper:
      # embedding ベースのグルーピングを有効化（llm.embedding_model の設定が必要）
      # true: 要約後の個別要約テキストを embedding してクラスタリング → LLM はトピック命名のみ
      # false（デフォルト）: 従来の LLM グルーピング（記事数が多いとコンテキスト溢れに注意）
      #use_embeddings: true
      # コサイン類似度の閾値（これ以上の類似度の記事を同一グループとみなす）
      #similarity_threshold: 0.85
      parameters:
        temperature: 0.1      # 低め：決定論的な分類を優先
        #max_tokens: 4096     # ステップ別に最大出力トークン数を上書きする場合

    summarizer:
      parameters:
        temperature: 0.3      # 標準的な多様性
        #max_tokens: 4096

    digest:
      #thinking: true         # thinking 有効時に temperature を除外したい場合（disable_temperature_with_thinking と組み合わせる）
      #parameters:            # 省略時はグローバル設定を継承
      #  temperature: 0.7
      #  max_tokens: 16384    # digest は長文になりやすいため大きめに設定
      #  reasoning_effort: "high"  # ステップ別に reasoning_effort を上書きする場合

# データベースの設定
database:
  # Cloud Runでは "firestore"、ローカルでは "sqlite"
  backend: "sqlite"
  path: "data/news_summarizer.db"
  #project_id: "your-google-cloud-project"
  #firestore_database: "(default)"

# Miniflux API の設定
miniflux:
  base_url: "http://your-miniflux-host"
  api_key: "your-miniflux-api-key"
  # 1回の取得で Miniflux に要求する未読記事の件数（既定 100、上限 1000）。
  # Miniflux は limit 未指定だとサーバ既定の 100 で打ち切るため、
  # summarizer.max_articles_per_run を上げるときはこちらも併せて上げること。
  # 取得後の重複除去で1割前後が落ちるので、max_articles_per_run より多めが目安。
  #fetch_limit: 100

# POP3 メールサーバーの設定
email:
  host: "your-mail-server.example.com"
  port: 995
  username: "your-email@example.com"
  password: "your-email-password"
  use_ssl: true
  # 削除しない設定（下記 delete_after_processing: false）では、保存に至らないメールは
  # 毎回本文全体をダウンロードし直すことになる。取得したが保存しなかった回数がこの値に
  # 達したら処理済み扱いにして取得対象から外す（poison message対策、デフォルト: 3）。
  max_fetch_attempts: 3
  # true にすると、処理が終わったメールをPOP3サーバから削除する（デフォルト: false）。
  # 削除対象は「DB保存に成功したメール」と「max_fetch_attempts に達して打ち切ったメール」の
  # 2種類のみ。要約や保存に失敗したメールはサーバに残るので、次回の実行で再試行される。
  # --dry-run 時は（--output db を付けた場合でも）常に削除をスキップする。
  delete_after_processing: false

# Discord Webhook の設定
discord:
  webhook_url: "https://discord.com/api/webhooks/your-webhook-url"
  embed_color: 5814786
  footer_text: "AI News Summarizer"  # フッターテキスト（空文字列 "" または省略で無効化）
  # 個別記事をダイジェストの後に1件ずつ投稿するか（デフォルト: false）。
  # true にすると全記事がカテゴリ別ダイジェストと個別 Embed で二重に届く。
  #post_individual_articles: true

# ロギング設定
logging:
  level: "INFO"  # DEBUG | INFO | WARNING | ERROR
